(version 1)

(rule "VSSOP-8 internal pad clearance"
   (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('Package_SO:VSSOP-8_3x3mm_P0.65mm') && B.memberOfFootprint('Package_SO:VSSOP-8_3x3mm_P0.65mm')")
   (constraint clearance (min 0.15mm))
)

(rule "SMA edge clearance"
    (constraint edge_clearance (min 0mm))
    (condition "A.insideArea('EDGE')")
)